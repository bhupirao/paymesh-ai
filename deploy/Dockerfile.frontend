FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY frontend/*.py ./
COPY frontend/index.html frontend/checkout.html ./
COPY frontend/assets ./assets
COPY deploy/frontend_entry.py ./container_entry.py
USER 10001:10001
ENTRYPOINT ["python", "-B", "/app/container_entry.py"]
