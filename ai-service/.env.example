PAYMESH_AI_HOST=127.0.0.1
PAYMESH_AI_PORT=8000
# DETERMINISTIC (default), RAG_ASSISTED (retrieval only), or RAG_LLM
PAYMESH_AI_ANALYSIS_MODE=DETERMINISTIC
PAYMESH_AI_GENERATION_ENABLED=false
# No runtime is installed or started by this service.
PAYMESH_AI_INFERENCE_URL=http://127.0.0.1:8080/v1/chat/completions
PAYMESH_AI_MODEL_NAME=local-model
PAYMESH_AI_GENERATION_TIMEOUT=10
PAYMESH_AI_MAX_OUTPUT_TOKENS=128
PAYMESH_AI_CONTEXT_CHARS=12000
PAYMESH_AI_RETRIEVAL_TOP_K=3
PAYMESH_AI_RETRIEVAL_CONTEXT_CHARS=3000
PAYMESH_AI_RETRIEVAL_THRESHOLD=0.12
PAYMESH_AI_REQUEST_BODY_BYTES=131072
