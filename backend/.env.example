# Placeholder values only. Copy outside the repository before editing.
PAYMESH_CONTAINER_DB_PASSWORD=replace_with_a_long_random_password
PAYMESH_CONTAINER_HTTP_PORT=18081
PAYMESH_JWT_KEY_DIR=/absolute/path/to/external/jwt-key-directory
PAYMESH_JWT_ISSUER=https://issuer.example.invalid
PAYMESH_JWT_AUDIENCE=paymesh-api
PAYMESH_RAZORPAY_WEBHOOK_SECRET=replace_with_a_random_secret
PAYMESH_STRIPE_WEBHOOK_SECRET=replace_with_a_random_secret
PAYMESH_SETTLEMENT_ADMIN_TOKEN=replace_with_a_random_token

# Java -> internal Python AI service (no merchant credentials forwarded).
PAYMESH_AI_ENABLED=false
PAYMESH_AI_BASE_URL=http://127.0.0.1:8000
PAYMESH_AI_CONNECT_TIMEOUT_MS=2000
PAYMESH_AI_RESPONSE_TIMEOUT_MS=45000
PAYMESH_AI_MAX_RESPONSE_BYTES=262144
